# 라이엇 API 키 — https://developer.riotgames.com
# (개발 키는 24시간마다 만료 / Personal·Production 키는 영구)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 선택: 키의 실제 한도 지정 ("용량:윈도초" 콤마 구분).
# 응답 헤더 X-App-Rate-Limit 값보다 약간 보수적으로 잡을 것.
# 미설정 시 개발 키 프리셋(20/1초, 100/2분)으로 동작한다.
# RIOT_RATE_LIMITS=45:10

# Supabase Postgres — 반드시 트랜잭션 풀러(6543) 사용
# (세션 모드 5432는 동시 15클라이언트 제한으로 EMAXCONNSESSION 발생)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# 새벽 자동 갱신 크론(/api/cron/refresh) 인증용 — Vercel 환경변수에도 동일하게 등록
# CRON_SECRET=

# 디스코드 슬래시 커맨드 봇 (/rift, /rift-team, /rift-duo, /rift-recent)
# 인터랙션 엔드포인트: {사이트}/api/discord/interactions
# DISCORD_PUBLIC_KEY=   # 서명 검증용 (개발자 포털 → General Information)
# DISCORD_BOT_TOKEN=    # 커맨드 등록·응답용
# DISCORD_CLIENT_ID=    # 애플리케이션 ID
# DISCORD_GUILD_ID=     # 커맨드를 등록할 서버 ID
